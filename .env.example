# Environment variables Phygital Memory's engine reads (core/phygital_memory). For developers and tests only.
# The app has no .env file and never reads one: its settings are buttons in the app (see docs/settings.md).
# To try one, set it in the shell before you start the engine from source, from the core folder, for example:
#   PHYGITAL_MEMORY_STATE=/tmp/pm-test uv run python -m phygital_memory.server
# Every line here is commented out, so nothing changes until you remove the #. Never put a password, key or token here.
# Every variable is explained in docs/settings.md.

# ---- where things go ----
# The folder of the first memory
# PHYGITAL_MEMORY_FOLDER=~/Phygital Memory

# The port of the local program. The built app always uses 8790
# PHYGITAL_MEMORY_PORT=8790

# Where the app keeps its own information. Default: the app folder for your system (see docs/settings.md)
# PHYGITAL_MEMORY_STATE=

# Where a shared Open memory becomes a normal folder on the other computer
# PHYGITAL_MEMORY_SHARED_COPIES=~/Documents/Shared with me

# Where old copies go when you move a memory. Default: the Trash on a Mac, ~/.local/share/Trash/files on Linux,
# "Moved away" in the app folder on Windows
# PHYGITAL_MEMORY_TRASH=

# Where the Finder view is mounted (Mac only). Default: Finder in the app folder
# PHYGITAL_MEMORY_MOUNTS=

# Where the Desktop shortcut goes
# PHYGITAL_MEMORY_DESKTOP=~/Desktop

# Where the app's own Syncthing keeps its files. Default: syncthing in the app folder
# PHYGITAL_MEMORY_SYNCTHING_HOME=

# ---- names and helper programs ----
# The name your other computer sees when linking (up to 40 characters). Default: this computer's name
# PHYGITAL_MEMORY_MAC_NAME=

# Path to another rclone program. Default: the one that comes with the app
# PHYGITAL_MEMORY_RCLONE=

# Path to another Touch ID helper (Mac only, runs from source only; the built app never uses it)
# PHYGITAL_MEMORY_TOUCHID=

# A different GitHub OAuth app, for testing. This is a public id, not a secret. Default: the app's own
# PHYGITAL_MEMORY_GITHUB_CLIENT_ID=

# ---- server mode only (docs/server.md). The server image sets these, except the address. The passphrase is optional ----
# PHYGITAL_MEMORY_SERVER=1
# PHYGITAL_MEMORY_URL=https://memory.example.com
# PHYGITAL_MEMORY_PASSPHRASE=
# PHYGITAL_MEMORY_DATA=/data
# PHYGITAL_MEMORY_SYNC_PORT=22000
# PHYGITAL_MEMORY_VERSION=

# ---- set by the app window for the engine, never by you ----
# PHYGITAL_MEMORY_SHELL_TOKEN=
# PHYGITAL_MEMORY_SERVER_PROOF=
# PHYGITAL_MEMORY_APP_PID=

# ---- test hooks, used only by core/tests/ (never on your real computer) ----
# No Finder windows, and never the person's real GitHub sign-in. Any value means on
# PHYGITAL_MEMORY_OFFLINE=1
# The app's Syncthing stays on 127.0.0.1: no discovery, relays or NAT. Any value means on
# PHYGITAL_MEMORY_SYNCTHING_LOCAL=1
# The app's Syncthing finds the other side only through internet discovery, not the local network. Any value means on
# PHYGITAL_MEMORY_SYNCTHING_NO_LAN=1
# Names of the secret store items, so tests never touch the real ones
# PHYGITAL_MEMORY_SEAL_KEYCHAIN=Phygital Memory seal
# PHYGITAL_MEMORY_CLOUD_KEYCHAIN=Phygital Memory cloud
# PHYGITAL_MEMORY_APPROVER_KEYCHAIN=Phygital Memory approver
# PHYGITAL_MEMORY_IDENTITY_KEYCHAIN=Phygital Memory identity
# PHYGITAL_MEMORY_TOUCHID_KEYCHAIN=Phygital Memory Touch ID (app only)
