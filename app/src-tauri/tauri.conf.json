{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Phygital Memory",
  "version": "0.1.0",
  "identifier": "io.phygital.memory",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "server/": "server/"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVFQThBMzc3OUY5NzAxRjAKUldUd0FaZWZkNk9vWG15Qzd5cVIzdi9kNTBRd1dLdmp4OS9mK3hTQWJwTWNpUHgzSWxaU2xNWXQK",
      "endpoints": [
        "https://github.com/Phygital-Brain/Phygital-Memory/releases/latest/download/latest.json"
      ]
    }
  }
}
